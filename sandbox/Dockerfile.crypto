# Crypto pack donor — SageMath (conda-forge) for additive install into L0.
# Ubuntu 24.04 to match ctf-sandbox-core userspace (apt has no sagemath on 24.04).
#
# Build (from repo root, needs network + ~10–20 min + several GB):
#   docker build -f sandbox/Dockerfile.crypto -t ctf-sandbox-crypto .
#
# Runtime: L0 stays ctf-sandbox-core; pack "crypto" copies /opt/sagemath in.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TERM=xterm
ENV LANG=C.UTF-8
ENV MAMBA_ROOT_PREFIX=/opt/micromamba

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl wget bzip2 tar \
    python3 python3-pip python3-dev \
    libgmp-dev \
    && rm -rf /var/lib/apt/lists/*

# Micromamba + Sage into a single prefix we can docker-cp into L0.
RUN set -eux; \
    arch="$(uname -m)"; \
    case "$arch" in \
      aarch64|arm64) mb_arch=linux-aarch64 ;; \
      x86_64|amd64)  mb_arch=linux-64 ;; \
      *) echo "unsupported arch: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://micro.mamba.pm/api/micromamba/${mb_arch}/latest" \
      | tar -xj -C /tmp bin/micromamba; \
    mv /tmp/bin/micromamba /usr/local/bin/micromamba; \
    micromamba create -y -p /opt/sagemath -c conda-forge sage; \
    micromamba clean -a -y; \
    rm -rf /tmp/bin "$MAMBA_ROOT_PREFIX/pkgs"

# Thin wrappers on PATH (copied with the pack via /usr/local/bin/sage*).
# Use Sage's python3 directly — newer sage CLI has no `sage -python`.
RUN printf '%s\n' '#!/bin/bash' 'exec /opt/sagemath/bin/sage "$@"' \
      > /usr/local/bin/sage \
    && printf '%s\n' '#!/bin/bash' 'exec /opt/sagemath/bin/python3 "$@"' \
      > /usr/local/bin/sage-python \
    && chmod +x /usr/local/bin/sage /usr/local/bin/sage-python \
    && /usr/local/bin/sage -c 'print("sage_ok", 1+1)'

# System python (donor image) + Sage python (so `sage` scripts can import Crypto).
RUN pip3 install --no-cache-dir --break-system-packages \
        pycryptodome sympy galois pwntools requests || \
    pip3 install --no-cache-dir pycryptodome sympy galois pwntools requests
RUN /opt/sagemath/bin/python3 -m pip install --no-cache-dir pycryptodome

COPY sandbox/scripts/gf128_roots.py /opt/ctf/gf128_roots.py
RUN printf '%s\n' '#!/bin/bash' 'exec python3 /opt/ctf/gf128_roots.py "$@"' \
      > /usr/local/bin/gf128-roots \
    && chmod +x /usr/local/bin/gf128-roots

COPY sandbox/sandbox-tools-crypto.txt /tools.txt

WORKDIR /challenge
CMD ["sleep", "infinity"]
