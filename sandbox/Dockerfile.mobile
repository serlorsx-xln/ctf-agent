# Mobile / Flutter RE sandbox (PWNKnight-class challenges).
# Ubuntu 24.04 for g++>=13 + modern ICU (required by blutter).
#
# Build (from repo root):
#   docker build -f sandbox/Dockerfile.mobile -t ctf-sandbox-mobile .
#
# Run:
#   uv run ctf-solve --image ctf-sandbox-mobile --challenge ./challenges/pwnknight ...

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TERM=xterm
ENV LANG=C.UTF-8
ENV PATH="/opt/jadx/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl wget git file xxd bsdmainutils unzip zip jq \
    netcat-openbsd socat \
    gcc g++ make cmake ninja-build nasm patch pkg-config \
    gdb gdbserver strace ltrace \
    binutils patchelf \
    qemu-user-static binfmt-support \
    python3 python3-pip python3-dev python3-venv \
    python3-pyelftools python3-requests \
    openjdk-17-jre-headless \
    android-tools-adb aapt \
    libssl-dev libffi-dev \
    libicu-dev libcapstone-dev \
    libc6-dbg \
    && rm -rf /var/lib/apt/lists/*

# radare2
RUN git clone --depth=1 https://github.com/radareorg/radare2 /tmp/r2 \
    && cd /tmp/r2 && ./sys/install.sh --install \
    && ldconfig \
    && rm -rf /tmp/r2

# jadx (CLI)
ARG JADX_VERSION=1.5.1
RUN mkdir -p /opt/jadx \
    && curl -fsSL -o /tmp/jadx.zip \
        "https://github.com/skylot/jadx/releases/download/v${JADX_VERSION}/jadx-${JADX_VERSION}.zip" \
    && unzip -q /tmp/jadx.zip -d /opt/jadx \
    && rm /tmp/jadx.zip \
    && chmod +x /opt/jadx/bin/jadx /opt/jadx/bin/jadx-gui || true

# apktool
ARG APKTOOL_VERSION=2.11.1
RUN mkdir -p /opt/apktool \
    && curl -fsSL -o /opt/apktool/apktool.jar \
        "https://github.com/iBotPeaches/Apktool/releases/download/v${APKTOOL_VERSION}/apktool_${APKTOOL_VERSION}.jar" \
    && printf '%s\n' '#!/bin/bash' 'exec java -jar /opt/apktool/apktool.jar "$@"' > /usr/local/bin/apktool \
    && chmod +x /usr/local/bin/apktool

# Python: pwn + mobile RE (do not upgrade system pip on Ubuntu 24.04)
RUN pip3 install --no-cache-dir --break-system-packages \
        pwntools \
        ROPgadget \
        capstone \
        unicorn \
        keystone-engine \
        requests \
        pyelftools \
        androguard \
        frida-tools \
        reflutter

# GEF
RUN curl -fsSL https://raw.githubusercontent.com/hugsy/gef/main/gef.py -o /root/.gdbinit-gef.py \
    && printf 'source /root/.gdbinit-gef.py\n' > /root/.gdbinit

# qemu helpers
RUN printf '%s\n' '#!/bin/bash' 'exec qemu-x86_64-static "$@"' > /usr/local/bin/q64 \
    && printf '%s\n' '#!/bin/bash' 'exec qemu-i386-static "$@"' > /usr/local/bin/q32 \
    && chmod +x /usr/local/bin/q64 /usr/local/bin/q32

# blutter (needs g++>=13; Ubuntu 24.04)
RUN git clone --depth=1 https://github.com/worawit/blutter.git /opt/blutter \
    && printf '%s\n' '#!/bin/bash' 'exec python3 /opt/blutter/blutter.py "$@"' > /usr/local/bin/blutter \
    && chmod +x /usr/local/bin/blutter

# Prebuild blutter for PWNKnight Dart snapshot so the agent does not compile at runtime.
# Fixtures live under sandbox/ (challenges/ is dockerignored). Needs libapp.so + libflutter.so.
COPY sandbox/fixtures/pwnknight-arm64 /tmp/pwnknight-arm64
RUN ls -la /tmp/pwnknight-arm64/ \
    && python3 /opt/blutter/blutter.py /tmp/pwnknight-arm64 /opt/blutter-pwnknight \
    && test -d /opt/blutter-pwnknight \
    && rm -rf /tmp/pwnknight-arm64 /opt/blutter/dartsdk /opt/blutter/build \
    && ls /opt/blutter/bin/ | head -20

COPY sandbox/sandbox-tools-mobile.txt /tools.txt

WORKDIR /challenge
CMD ["sleep", "infinity"]
