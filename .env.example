# CTFd
CTFD_URL=https://ctf.example.com
CTFD_TOKEN=ctfd_your_api_token_here

# Cursor (primary backend)
# Create a key at https://cursor.com/dashboard/integrations
CURSOR_API_KEY=cursor_...

# Sandbox image (default: ctf-sandbox)
# For pwn challenges prefer the amd64 pwn image:
#   docker build --platform linux/amd64 -f sandbox/Dockerfile.pwn -t ctf-sandbox-pwn .
#   then: uv run ctf-solve --image ctf-sandbox-pwn ...
# For Flutter/Android (e.g. PWNKnight):
#   docker build -f sandbox/Dockerfile.mobile -t ctf-sandbox-mobile .
#   then: uv run ctf-solve --image ctf-sandbox-mobile ...
# SANDBOX_IMAGE=ctf-sandbox-pwn

# Optional: Claude / OpenAI / Gemini backends
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
