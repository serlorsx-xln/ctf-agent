# Cursor (primary backend)
# Create a key at https://cursor.com/dashboard/integrations
CURSOR_API_KEY=cursor_...

# L0 core (always start here). Packs attach into the same container.
# Prefetched packs bind-mount from the host cache (shared RO); late packs may
# still docker-cp. Set CTF_PACK_BIND=0 to force copy-only.
# SANDBOX_IMAGE=ctf-sandbox-core
# CTF_PACK_CACHE=$HOME/.cache/ctf-agent/packs
# CTF_PACK_CACHE_MAX_GB=25
# CTF_PACK_BIND=1
#
# Build once:
#   docker build -f sandbox/Dockerfile.core -t ctf-sandbox-core .
#   docker build -f sandbox/Dockerfile.mobile -t ctf-sandbox-mobile .
#   docker build -f sandbox/Dockerfile.pwn -t ctf-sandbox-pwn .
# Required for .sage / SageMath challenges (additive crypto pack donor):
#   docker build -f sandbox/Dockerfile.crypto -t ctf-sandbox-crypto .
# Optional multi-stage donors:
#   docker build -f sandbox/Dockerfile.crypto-tools -t ctf-sandbox-crypto-tools .
#   docker build -f sandbox/Dockerfile.steg -t ctf-sandbox-steg .
#   docker build -f sandbox/Dockerfile.linux -t ctf-sandbox-linux .
# Override L0 only with CLI: --image <name>
# Do not build Dockerfile.sandbox (deprecated fat image).

# Memory: default 16g. Heavy packs raise the live limit automatically
# (crypto≥12g, ml/crypto-tools≥8g, pwn/mobile≥6g) when loaded.
# CONTAINER_MEMORY_LIMIT=8g
#
# Pack host cache (shared RO binds). Cap + LRU eviction (0 = unlimited):
# CTF_PACK_CACHE=$HOME/.cache/ctf-agent/packs
# CTF_PACK_CACHE_MAX_GB=25
# CTF_PACK_BIND=1
#
# Disk hygiene after rebuilds:
#   bash scripts/prune_docker.sh
#   uv run python scripts/evict_pack_cache.py

# Harder challenges — keep DEFAULT composer-2.5, override per run:
#   --models cursor/claude-4-sonnet
#   --models claude-sdk/claude-opus-4-6
#   --models codex/gpt-5.4

# Optional: Claude / OpenAI / Gemini backends
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
