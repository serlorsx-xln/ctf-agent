# Credentials
.env
creds.json

# Logs and traces
logs/
*.log
*.jsonl

# Challenge data (downloaded at runtime)
challenges*/

# Python
__pycache__/
*.pyc
*.egg-info/
dist/
build/
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
uv.lock

# Node / Bun (chassis TUI)
node_modules/
**/node_modules/
.turbo/
*.tsbuildinfo
*.heapsnapshot

# OS junk (ExFAT/USB volumes recreate AppleDouble metadata)
.DS_Store
._*
**/._*

# Local challenge archives (not part of the product)
challenges.zip

# Local unpack / blutter test blobs (not part of the product)
sandbox/fixtures/

# Local challenge service state (flags, socat pid)
challenges/*/.local-service/

# Runtime
workspace/
codex-schema-*/
.claude/scheduled_tasks.lock

# Organizer/build trees — not agent handouts
challenges/*/.service-src/
challenges/*/Dockerfile.local

# Human-only expected flags (never mount / never prompt)
eval/sealed/

# Linux ELFs compiled into owned fixtures (host clang is Mach-O)
eval/fixtures/rev-crackme/distfiles/crackme
eval/fixtures/pwn-auth/distfiles/vuln

# OpenCode TUI build stub (scripts/build-tui.sh)
chassis/.github/TEAM_MEMBERS
