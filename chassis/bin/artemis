#!/usr/bin/env bash
# Artemis TUI launcher (vendored chassis + Python CTF backend).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REPO="$(cd "$ROOT/.." && pwd)"

resolve_bun() {
  if command -v bun >/dev/null 2>&1; then
    command -v bun
    return 0
  fi
  for candidate in \
    "${BUN_INSTALL:+$BUN_INSTALL/bin/bun}" \
    "$HOME/.bun/bin/bun" \
    /usr/local/bin/bun \
    /opt/homebrew/bin/bun
  do
    if [[ -n "${candidate:-}" && -x "$candidate" ]]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

run_python() {
  if [[ -x "$REPO/.venv/bin/python" ]]; then
    "$REPO/.venv/bin/python" "$@"
  elif command -v uv >/dev/null 2>&1; then
    uv run --directory "$REPO" python "$@"
  else
    python3 "$@"
  fi
}

BUN_BIN="$(resolve_bun)" || {
  echo "Artemis TUI requires Bun." >&2
  echo "  Install:  curl -fsSL https://bun.sh/install | bash" >&2
  echo "  Then:     export PATH=\"\$HOME/.bun/bin:\$PATH\"" >&2
  echo "Swarm-only: uv run artemis swarm --challenge PATH" >&2
  exit 1
}
export PATH="$(dirname "$BUN_BIN"):${PATH:-}"

export ARTEMIS=1
export ARTEMIS_CHASSIS_ROOT="$ROOT"
export ARTEMIS_REPO_ROOT="$REPO"
unset OPENCODE_PURE 2>/dev/null || true
export OPENCODE_CONFIG="${OPENCODE_CONFIG:-$ROOT/opencode.json}"

# Optional repo .env for Docker/sandbox non-secrets only.
# API keys must come from TUI /connect (auth.json) — never auto-connect from .env.
if [[ -f "$REPO/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$REPO/.env"
  set +a
fi
unset CURSOR_API_KEY ANTHROPIC_API_KEY OPENAI_API_KEY GEMINI_API_KEY 2>/dev/null || true

# Inject keys + start daemon/stub in background (no blocking waits).
# Credentials on stdout (eval); bootstrap warnings go to bootstrap.log and
# optionally the terminal if ARTEMIS_BOOTSTRAP_VERBOSE=1.
_BOOT_ERR="${ARTEMIS_CACHE:-$HOME/.cache/artemis}/logs/bootstrap.err"
mkdir -p "$(dirname "$_BOOT_ERR")" 2>/dev/null || true
eval "$(
  run_python "$REPO/scripts/tui_bootstrap.py" --emit export 2>"$_BOOT_ERR" || true
)"
if [[ -s "$_BOOT_ERR" ]]; then
  if [[ "${ARTEMIS_BOOTSTRAP_VERBOSE:-}" == "1" ]]; then
    cat "$_BOOT_ERR" >&2 || true
  else
    echo "artemis: bootstrap warnings (see $_BOOT_ERR or ~/.cache/artemis/logs/)" >&2 || true
  fi
fi
unset _BOOT_ERR

cd "$ROOT"
set +e
"$BUN_BIN" --cwd packages/opencode --conditions=browser src/index.ts "$@"
code=$?
set -e

exit "$code"
